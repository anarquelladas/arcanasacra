---
interface Props { title: string; kicker?: string }
const { title, kicker } = Astro.props;
---
<header class="page-head">
  {kicker && <p class="kicker caps">{kicker}</p>}
  <h1>{title}</h1>
  <span class="rule" aria-hidden="true"></span>
  <div class="intro"><slot /></div>
</header>

<style>
  .page-head { text-align: center; max-width: 1000px; margin: 3.5rem auto 3.2rem; padding: 0 1.25rem; }
  .kicker { margin: 0 0 1.4rem; color: var(--ink-dim); letter-spacing: .42em; font-size: .85rem; }
  h1 {
    margin: 0; font-weight: 400; font-family: var(--script);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem); line-height: 1.7;
    animation: ink 1.4s var(--ease) both;
  }
  .rule { display: block; width: 140px; height: 1px; margin: 1.2rem auto 1rem; background: linear-gradient(90deg, transparent, var(--ink-dim), transparent); }
  :global(.ph-band) { display: block; width: min(400px, 80%); height: auto; margin: .4rem auto .2rem; opacity: .9; }
  .intro { color: var(--ink-dim); font-size: 1.12rem; font-style: italic; }
  .intro :global(p) { margin: .4em 0; }
  @keyframes ink { from { filter: blur(10px); opacity: 0; } }
</style>
